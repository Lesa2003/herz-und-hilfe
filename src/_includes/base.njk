{% set palette = themePresets[theme.preset] or themePresets.waldgruen %}
<!doctype html>
<html lang="de" class="size-{{ theme.size or 'standard' }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }}</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>💚</text></svg>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}" />
  <style>
    :root {
      --dark-green: {{ palette.dark }};
      --dark-green-2: {{ palette.dark2 }};
      --accent-green: {{ palette.accent }};
      --light-green: {{ palette.light }};
      --mint-bg: {{ palette.mintBg }};
      --mint-border: {{ palette.mintBorder }};
    }
  </style>
</head>
<body>

  <header class="site-header">
    <nav>
      <a href="#top" class="brand">{{ brand }}</a>
      <div class="nav-links">
        <a href="#leistungen">Leistungen</a>
        <a href="#kontakt">Kontakt</a>
        <a class="btn btn-sm" href="tel:{{ contact.phone | replace(' ', '') }}">Jetzt anrufen</a>
      </div>
    </nav>
  </header>

  <section class="hero" id="top">
    <div class="hero-inner">
      <span class="hero-heart" aria-hidden="true">💚</span>
      <h1 class="wordmark{% if theme.wordmark_style == 'sans' %} sans{% endif %}">{{ brand }}</h1>
      <p class="tagline">{{ tagline }}</p>
      <p class="hero-subtitle">{{ subtitle }}</p>
      <a class="btn" href="#kontakt">Kontakt aufnehmen</a>
    </div>
  </section>

  <main>
    <section class="intro prose">
      {{ intro | markdown | safe }}
    </section>

    {% if content_blocks and content_blocks.length %}
    <section class="content-blocks">
      {% for block in content_blocks %}
        {% if block.type == "text" %}
          <div class="block block-text prose">
            {% if block.heading %}<h2>{{ block.heading }}</h2>{% endif %}
            {{ block.body | markdown | safe }}
          </div>
        {% elif block.type == "image" %}
          <figure class="block block-image">
            <img src="{{ block.src }}" alt="{{ block.alt }}" loading="lazy" />
            {% if block.caption %}<figcaption>{{ block.caption }}</figcaption>{% endif %}
          </figure>
        {% endif %}
      {% endfor %}
    </section>
    {% endif %}

    <section class="services" id="leistungen">
      <div class="services-grid">
        {% for cat in service_categories %}
          <div class="service-card">
            <h2><span class="service-icon" aria-hidden="true">{{ cat.icon }}</span>{{ cat.category_title }}</h2>
            <ul class="checklist">
              {% for item in cat.items %}
                <li>{{ item }}</li>
              {% endfor %}
            </ul>
          </div>
        {% endfor %}
      </div>
    </section>

    {% if billing_box %}
    <section class="billing-box">
      <h3><span aria-hidden="true">✨</span> {{ billing_box.box_title }}</h3>
      <div class="prose"><p>{{ billing_box.body | markdownInline | safe }}</p></div>
      {% if billing_box.note %}<p class="billing-note">{{ billing_box.note }}</p>{% endif %}
    </section>
    {% endif %}
  </main>

  <footer class="site-footer" id="kontakt">
    <div class="footer-inner">
      <div class="footer-brand">
        <span class="hero-heart small" aria-hidden="true">💚</span>
        <h2 class="wordmark small{% if theme.wordmark_style == 'sans' %} sans{% endif %}">{{ brand }}</h2>
        <p class="tagline small">{{ tagline }}</p>
      </div>

      <div class="footer-grid">
        <div class="footer-col">
          <p>{{ contact.owner }}</p>
          <p>{{ contact.hours }}</p>
          <p>Einsatzgebiet: {{ contact.service_area }}</p>
        </div>
        <div class="footer-col">
          <p><span aria-hidden="true">📞</span> <a href="tel:{{ contact.phone | replace(' ', '') }}">{{ contact.phone }}</a></p>
          <p><span aria-hidden="true">✉️</span> <a href="mailto:{{ contact.email }}">{{ contact.email }}</a></p>
          <p><span aria-hidden="true">📍</span> {{ contact.address_line1 }}, {{ contact.address_line2 }}</p>
        </div>
      </div>

      <p class="copyright">&copy; {% year %} {{ brand }}</p>
    </div>
  </footer>
</body>
</html>
